{
  "name": "nvcclub",
  "version": "1.0.0",
  "description": "NVC成长乐园 - 专为NVC中文网年度会员设计的专属游戏化成长平台",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/rampagepeter/nvcclub",
  "repository": {
    "type": "git",
    "url": "https://github.com/rampagepeter/nvcclub.git"
  },
  "bugs": {
    "url": "https://github.com/rampagepeter/nvcclub/issues"
  },
  "author": "NVC中文网技术团队",
  "license": "MIT",
  "keywords": [
    "NVC",
    "非暴力沟通",
    "Vue3",
    "TypeScript",
    "成长平台",
    "同理心"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:prod": "npm run type-check && vite build --mode production",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "clean": "rm -rf dist node_modules/.vite",
    "test:build": "npm run build && npm run preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^13.3.0",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "element-plus": "^2.10.1",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  }
}
